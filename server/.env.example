# Noah Wallet – Server Environment Variables

# Port the HTTP server listens on
PORT=8080

# ── Blockchain data providers (priority: Moralis → Covalent → Ankr) ─────────
# On HTTP 429 the server automatically cools that provider for 60 s and falls
# back to the next one. All three are free-tier.

# Primary: Moralis — supports all endpoints (https://admin.moralis.io)
MORALIS_API_KEY=your_moralis_api_key_here

# Secondary: Covalent GoldRush — balances, NFTs, txns (https://goldrush.dev)
COVALENT_API_KEY=your_covalent_api_key_here

# Tertiary: Ankr Advanced API — balances, NFTs, txns (https://www.ankr.com/rpc)
# Leave empty to use the public (heavily rate-limited) Ankr endpoint.
ANKR_API_KEY=

# Comma-separated list of valid API keys for client authentication.
# Leave empty to disable auth (development only).
API_KEYS=changeme_key1,changeme_key2

# Comma-separated allowed CORS origins.
# Leave empty to allow all origins (development only).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
