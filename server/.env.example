# Noah Wallet – Server Environment Variables

# Port the HTTP server listens on
PORT=8080

# Moralis API key (get yours at https://admin.moralis.io)
MORALIS_API_KEY=your_moralis_api_key_here

# Comma-separated list of valid API keys for client authentication.
# Leave empty to disable auth (development only).
API_KEYS=changeme_key1,changeme_key2

# Comma-separated allowed CORS origins.
# Leave empty to allow all origins (development only).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
