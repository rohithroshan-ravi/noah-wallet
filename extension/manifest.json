{
  "manifest_version": 3,
  "name": "Noah Wallet",
  "description": "Noah Wallet browser extension for EVM chains.",
  "version": "0.1.0",
  "action": {
    "default_title": "Noah Wallet"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inpage.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
